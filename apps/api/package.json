{
  "name": "@prodexa/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hosted Prodexa discovery, license, and control API",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/db/run-migrate.ts"
  },
  "dependencies": {
    "@fastify/helmet": "^13.1.1",
    "fastify": "^5.12.1",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
