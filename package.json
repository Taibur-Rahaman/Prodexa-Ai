{
  "name": "prodexa-ai",
  "private": true,
  "description": "Prodexa AI — hosted product discovery platform and WordPress client plugin",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/api"
  ],
  "scripts": {
    "dev": "npm run dev -w @prodexa/api",
    "build": "npm run build -w @prodexa/api",
    "start": "npm run start -w @prodexa/api",
    "test": "npm run test -w @prodexa/api",
    "test:plugin": "php plugins/prodexa-ai/tests/run.php",
    "typecheck": "npm run typecheck -w @prodexa/api",
    "migrate": "npm run migrate -w @prodexa/api"
  }
}
