# Prodexa AI environment template
# Never put real credentials in this file.

APP_ENV=development
HOST=0.0.0.0
PORT=8000
APP_URL=http://localhost
API_BASE_URL=http://localhost:8000
LOG_LEVEL=info

# Database (local/dev only; never a production Hostinger DSN in git)
DATABASE_URL=postgres://prodexa:prodexa@127.0.0.1:5432/prodexa
AUTH_TIMESTAMP_SKEW_SECONDS=300
VALIDATE_RATE_LIMIT_PER_MINUTE=60

# Cache
CACHE_URL=

# Authentication / signing (generate locally; never commit real values)
API_SIGNING_SECRET=
LICENSE_SIGNING_SECRET=

# AI provider (optional during early development)
AI_PROVIDER=
AI_API_KEY=

# Billing provider (future)
BILLING_PROVIDER=
BILLING_WEBHOOK_SECRET=
